REFLEX_CLOUD_ENVIRONMENT=development
REFLEX_CLOUD_DATABASE_URL=sqlite:///./data/reflex-cloud.db
REFLEX_CLOUD_UPLOAD_DIRECTORY=./data/uploads
REFLEX_CLOUD_ADMIN_TOKEN=replace-with-at-least-32-random-characters
REFLEX_CLOUD_TOKEN_PEPPER=replace-with-at-least-32-random-characters
REFLEX_CLOUD_RETENTION_DAYS=90
REFLEX_CLOUD_FEEDBACK_LIMIT_PER_HOUR=10
REFLEX_CLOUD_FREE_REQUESTS_PER_DAY=20
REFLEX_CLOUD_FREE_INPUT_CHARS_PER_DAY=200000
REFLEX_CLOUD_FREE_OUTPUT_CHARS_PER_DAY=200000
REFLEX_CLOUD_PROVIDER_API_KEY=replace-with-server-provider-key
REFLEX_CLOUD_PROVIDER_BASE_URL=https://api.minimaxi.com/v1/chat/completions
REFLEX_CLOUD_PROVIDER_MODEL=MiniMax-M2.7-highspeed
REFLEX_CLOUD_PROVIDER_TIMEOUT_SECONDS=90
REFLEX_CLOUD_PROVIDER_PRICING_VERSION=replace-with-provider-pricing-version
REFLEX_CLOUD_PROVIDER_INPUT_USD_PER_MILLION_TOKENS=0
REFLEX_CLOUD_PROVIDER_OUTPUT_USD_PER_MILLION_TOKENS=0
REFLEX_CLOUD_PROVIDER_ESTIMATED_CHARS_PER_TOKEN=2
REFLEX_CLOUD_TEMPLATE_PACK_DIRECTORY=../../template-packs/builtin
REFLEX_CLOUD_MAX_CONCURRENT_GLOBAL=32
REFLEX_CLOUD_MAX_CONCURRENT_PER_INSTALLATION=2
REFLEX_CLOUD_FREE_IP_REQUESTS_PER_HOUR=60
REFLEX_CLOUD_RETENTION_CLEANUP_INTERVAL_SECONDS=86400
