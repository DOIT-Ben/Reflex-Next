{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Reflex",
  "version": "0.1.0",
  "identifier": "com.reflex.next",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reflex",
        "width": 760,
        "height": 540,
        "minWidth": 680,
        "minHeight": 480,
        "maxWidth": 920,
        "maxHeight": 720,
        "resizable": true,
        "center": true,
        "transparent": false,
        "shadow": true,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
