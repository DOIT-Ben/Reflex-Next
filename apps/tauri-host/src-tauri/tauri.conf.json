{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Reflex",
  "version": "0.7.0-alpha.8",
  "identifier": "com.reflex.next",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reflex",
        "width": 1200,
        "height": 650,
        "minWidth": 945,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false,
        "transparent": false,
        "shadow": true,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": [
        "main-capability",
        "history-capability",
        "panel-capability"
      ],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/runtime/reflex-runtime.exe": "runtime/reflex-runtime.exe"
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
