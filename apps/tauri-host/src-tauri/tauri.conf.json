{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Reflex",
  "version": "0.7.0-alpha.8",
  "identifier": "com.reflex.next",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reflex",
        "width": 760,
        "height": 540,
        "minWidth": 680,
        "minHeight": 480,
        "maxWidth": 920,
        "maxHeight": 720,
        "resizable": true,
        "center": true,
        "transparent": true,
        "shadow": true,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["main-capability", "history-capability"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/runtime/reflex-runtime.exe": "runtime/reflex-runtime.exe"
    },
    "icon": ["icons/icon.ico"]
  }
}
