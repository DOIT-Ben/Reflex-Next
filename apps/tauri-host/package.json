    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
